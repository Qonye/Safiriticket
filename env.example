# Pesapal API 3.0 Configuration
# Copy this file to .env and fill in your actual values
# Get your credentials from: https://developer.pesapal.com/api3-demo-keys.txt

# Sandbox Credentials (for testing)
PESAPAL_CONSUMER_KEY=qkio1BGGYAXTu2JOfm7XSXNruoZsrqEW
PESAPAL_CONSUMER_SECRET=osGQ364R49cXKeOYSpaOnT++rHs=

# Production Credentials (get from Pesapal merchant account)
# PESAPAL_CONSUMER_KEY=your-production-consumer-key
# PESAPAL_CONSUMER_SECRET=your-production-consumer-secret

# API Base URLs
# Sandbox
PESAPAL_BASE_URL=http://cybqa.pesapal.com/pesapalv3
# Production (uncomment when going live)
# PESAPAL_BASE_URL=http://pay.pesapal.com/v3

# IPN (Instant Payment Notification) URL
# Update this with your actual backend URL
# Register this URL at: https://cybqa.pesapal.com/PesapalIframe/PesapalIframe3/IpnRegistration
# For production: Use the production IPN registration form
PESAPAL_IPN_URL=https://your-backend.com/api/payments/pesapal-webhook

# IPN ID (optional - will be auto-registered if not provided)
# Get this from the IPN registration form or after first registration
# PESAPAL_IPN_ID=your-ipn-id

# Callback URL (where customers are redirected after payment)
PESAPAL_CALLBACK_URL=https://admin.safiritickets.com/payment-success

# Legacy IntaSend (can be removed after migration is complete)
# INTASEND_PUBLISHABLE_KEY=your-intasend-key
# INTASEND_API_KEY=your-intasend-key
# INTASEND_TEST_MODE=true

# MongoDB
MONGO_URI=your-mongodb-connection-string

# JWT Secret
JWT_SECRET=your-jwt-secret-key

# Other existing environment variables...
# Add your other env vars here

